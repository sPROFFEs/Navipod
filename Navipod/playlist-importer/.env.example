# Internal Concierge URL on the Docker network.
NAVIPOD_BASE_URL=http://concierge:8000

# Public HTTPS origin for Navipod. Do not include a trailing slash.
NAVIPOD_PUBLIC_ORIGIN=https://navipod.example.test

# External Docker network shared with Navipod.
NAVIPOD_DOCKER_NETWORK=navipod-global

# Local paths. To enable cover invalidation, the second path must point to the
# cover_cache directory used by the same Navipod instance.
IMPORTER_DATA_HOST_PATH=./data
NAVIPOD_COVER_CACHE_HOST_PATH=./cover-cache

# Generate with:
# python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
IMPORTER_FERNET_KEY=REPLACE_WITH_A_NEW_FERNET_KEY

IMPORT_CONCURRENCY=3
MAX_ATTEMPTS=3
RETRY_BASE_SECONDS=30
FAVORITE_DELAY_SECONDS=0.5
FAVORITE_BATCH_SIZE=10

# Only required to enumerate Spotify playlists.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional path inside the container.
YTDLP_COOKIE_FILE=/data/youtube-cookies.txt
